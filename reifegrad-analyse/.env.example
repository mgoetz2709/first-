# Lokal ist keine Variable nötig: Ohne Speicher-Token schreibt /api/submit
# nach ./submissions.

# Zugang zum Vercel-Blob-Speicher. Auf Vercel NICHT von Hand setzen: Vercel
# trägt BLOB_STORE_ID ein, sobald ein Blob-Speicher mit dem Projekt verbunden
# ist (ältere Verbindungen: BLOB_READ_WRITE_TOKEN).
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# --- Optional ---
# Kommagetrennte Liste vergebener Kürzel, z. B. K-001,K-002.
# Leer: jedes Kürzel im Format K-000 wird angenommen.
ERLAUBTE_KUERZEL=
# Anderer Endpoint statt /api/submit (wird beim Build eingesetzt).
SUBMIT_ENDPOINT=
