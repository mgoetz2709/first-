# Lokal ist keine Variable nötig: Ohne Drive-Konfiguration schreibt
# /api/submit nach ./submissions.

# --- Ablage in Google Drive (auf Vercel erforderlich) ---
# E-Mail-Adresse des Dienstkontos
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Privater Schlüssel aus der JSON-Schlüsseldatei (Feld "private_key"),
# einzeilig mit \n. Geheim: nie committen, nie in einen Chat kopieren.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# ID des Zielordners in einer geteilten Ablage
GOOGLE_DRIVE_FOLDER_ID=

# --- Optional ---
# Kommagetrennte Liste vergebener Kürzel, z. B. K-001,K-002.
# Leer: jedes Kürzel im Format K-000 wird angenommen.
ERLAUBTE_KUERZEL=
# Anderer Endpoint statt /api/submit (wird beim Build eingesetzt).
SUBMIT_ENDPOINT=
