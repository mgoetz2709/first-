---
import Basis from '../layouts/Basis.astro';
import HighlightBox from './HighlightBox.astro';
import Slash from './Slash.astro';
interface Props {
  titel: string;
  abschnitte: { titel: string; luecken: string[] }[];
}
const { titel, abschnitte } = Astro.props;
---

<Basis
  titel={`${titel} | MGIM`}
  beschreibung={`${titel} der KI-Reifegrad-Analyse von MGIM (Entwurf).`}
  noindex
  basis="/"
>
  <div class="seite abschnitt">
    <p class="label flex items-center gap-2"><Slash class="h-4 w-2" />Rechtliches</p>
    <h1 class="mt-3 text-4xl sm:text-5xl">{titel}</h1>
    <HighlightBox class="mt-8 max-w-text">
      <p>
        <strong>Entwurf, nicht rechtsgültig.</strong> Diese Seite ist ein Gerüst. Alle Angaben in eckigen Klammern sind
        Lücken, die MGIM nach rechtlicher Prüfung füllt. Vor der Veröffentlichung vollständig ersetzen.
      </p>
    </HighlightBox>
    {
      abschnitte.map((a) => (
        <section class="mt-10 max-w-text">
          <h2 class="text-2xl">{a.titel}</h2>
          <ul class="mt-3 space-y-2">
            {a.luecken.map((l) => (
              <li class="platzhalter">{l}</li>
            ))}
          </ul>
        </section>
      ))
    }
    <p class="mt-12"><a href="/">Zurück zur Startseite</a></p>
  </div>
</Basis>
