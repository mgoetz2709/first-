---
import Basis from '../layouts/Basis.astro';
import Slash from './Slash.astro';
import type { Rechtsabschnitt } from '../data/recht';
interface Props {
  titel: string;
  beschreibung: string;
  abschnitte: Rechtsabschnitt[];
}
const { titel, beschreibung, abschnitte } = Astro.props;
---

<Basis titel={`${titel} | MGIM KI-Reifegrad-Analyse`} beschreibung={beschreibung} basis="/">
  <div class="seite abschnitt">
    <p class="label flex items-center gap-2"><Slash class="h-4 w-2" />Rechtliches</p>
    <h1 class="mt-3 text-4xl sm:text-5xl">{titel}</h1>
    {
      abschnitte.map((a) => (
        <section class="mt-10 max-w-text">
          <h2 class="text-2xl">{a.titel}</h2>
          <p class="mt-3 whitespace-pre-line">{a.text}</p>
        </section>
      ))
    }
    <p class="mt-12"><a href="/">Zurück zur Startseite</a></p>
  </div>
</Basis>
