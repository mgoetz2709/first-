---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  titel: string;
  beschreibung: string;
  /** Seite nicht indexieren lassen. */
  noindex?: boolean;
  basis?: string;
}
const { titel, beschreibung, noindex = false, basis = '' } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titel}</title>
    <meta name="description" content={beschreibung} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#F5F5F5" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/barlow-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a
      href="#inhalt"
      class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:bg-white focus:p-3 focus:text-near-black"
      >Zum Inhalt springen</a
    >
    <Header basis={basis} />
    <main id="inhalt">
      <slot />
    </main>
    <Footer />
  </body>
</html>
