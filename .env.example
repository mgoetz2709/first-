# Postgres connection strings. On Vercel, create a Postgres database under
# Storage → Create Database (powered by Neon) and it fills these in for you —
# map its POSTGRES_PRISMA_URL to DATABASE_URL and POSTGRES_URL_NON_POOLING to
# DIRECT_URL. Locally, point both at the same database.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

ANTHROPIC_API_KEY="sk-ant-..."

# Required in production: shared password protecting the whole app (HTTP Basic
# Auth, any username works). Leave unset locally to skip the prompt.
APP_PASSWORD="choose-a-strong-shared-password"
