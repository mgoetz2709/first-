# Kontaktformular (inkl. Terminanfragen) & Newsletter-Double-Opt-In /
# Transactional-Mail (Resend).
# Ohne RESEND_API_KEY läuft der Versand im Mock-Modus (Log statt E-Mail).
RESEND_API_KEY=
CONTACT_TO_EMAIL=kontakt@markusgoetz.com
CONTACT_FROM_EMAIL=webseite@markusgoetz.com
NEXT_PUBLIC_CONTACT_RESPONSE_TIME_TEXT=Antwort innerhalb von 2 Werktagen

# AI-Potenzial-Scout (Anthropic API). Ohne ANTHROPIC_API_KEY läuft der Scout
# im Mock-Modus mit klar gekennzeichneten Demo-Antworten.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Hartes Limit lt. architecture.md, nicht über 300 hinaus konfigurierbar.
AGENT_MAX_TOKENS=300
# Max. Antworten pro Session (serverseitiger Hard Stop, unabhängig vom Prompt).
AGENT_MAX_TURNS=6
AGENT_SESSION_TTL_MS=1800000
# Geheimnis zum Signieren des Session-Cookies. In Produktion zwingend setzen
# (z. B. openssl rand -hex 32).
AGENT_RATE_LIMIT_SECRET=

# IP-Rate-Limit & Tages-/Monatsbudget des Scouts brauchen geteilten Zustand
# über alle Besucher hinweg — dafür Upstash Redis (z. B. über die "Vercel
# KV"/Upstash-Marketplace-Integration in Vercel anlegen, Werte werden dort
# meist automatisch als Env-Vars gesetzt). Ohne diese zwei Werte bleibt nur
# das Session-Turn-Limit aktiv, IP-Limit und Budget-Deckel sind inaktiv.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AGENT_MAX_SESSIONS_PER_IP_DAY=2
AGENT_DAILY_BUDGET_USD=5
AGENT_MONTHLY_BUDGET_USD=50
# Aktuelle Sonnet-5-Preise (verifiziert 30.07.2026, gültig bis 31.08.2026;
# danach $3/$15 - siehe platform.claude.com/docs/en/about-claude/pricing).
AGENT_PRICE_INPUT_PER_MTOK=2
AGENT_PRICE_OUTPUT_PER_MTOK=10

# Geheimnis zum Signieren der Double-Opt-In-Bestätigungslinks (E-Mail-Capture
# im Scout-Widget). In Produktion zwingend setzen (z. B. openssl rand -hex 32).
NEWSLETTER_TOKEN_SECRET=
