# Kalender-Buchungslink (z. B. Calendly-Embed-URL). Solange leer, zeigt die
# Kontaktseite einen klar erkennbaren Platzhalter statt eines echten Embeds.
NEXT_PUBLIC_CALENDAR_EMBED_URL=
NEXT_PUBLIC_CALENDAR_PROVIDER=Calendly

# Kontaktformular / Transactional-Mail (Resend). Ohne RESEND_API_KEY läuft
# der Formularversand im Mock-Modus (Log statt echtem E-Mail-Versand).
RESEND_API_KEY=
CONTACT_TO_EMAIL=kontakt@markusgoetz.com
CONTACT_FROM_EMAIL=webseite@markusgoetz.com
NEXT_PUBLIC_CONTACT_RESPONSE_TIME_TEXT=Antwort innerhalb von 2 Werktagen

# Probeagent (Anthropic API). Ohne ANTHROPIC_API_KEY läuft der Agent im
# Mock-Modus mit klar gekennzeichneten Demo-Antworten.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
AGENT_MAX_TOKENS=400
AGENT_RATE_LIMIT_MAX=15
AGENT_RATE_LIMIT_WINDOW_MS=1800000
# Geheimnis zum Signieren des Rate-Limit-Cookies. In Produktion zwingend
# setzen (z. B. openssl rand -hex 32).
AGENT_RATE_LIMIT_SECRET=
